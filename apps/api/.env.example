# Copy to apps/api/.env for local development.

DATABASE_URL=postgresql://bioverse:bioverse@localhost:5432/bioverse

# AI: "auto" uses Claude when an Anthropic credential is present, rules otherwise. "on" / "off" force it.
BIOVERSE_AI=auto
BIOVERSE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Only needed when the web app is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173

# Seed data and safety messages.
BIOVERSE_CLINIC_TZ=America/New_York
BIOVERSE_EMERGENCY_NUMBER=911
BIOVERSE_CRISIS_LINE=988
